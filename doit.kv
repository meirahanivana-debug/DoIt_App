ScreenManager:
    LoginScreen:
        name: "login"
    RegisterScreen:
        name: "register"
    MainScreen:
        name: "main"
    EditProfileScreen:
        name: "edit_profile"

<LoginScreen>:
    MDFloatLayout:
        md_bg_color: 0.94, 0.96, 0.98, 1

        MDCard:
            size_hint: 0.88, None
            height: "470dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [20]
            padding: ["20dp", "24dp", "20dp", "20dp"]

            MDBoxLayout:
                orientation: "vertical"
                spacing: "16dp"

                # Logo diperbesar secara signifikan
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "80dp"
                    pos_hint: {"center_x": 0.5}
                    spacing: "10dp"

                    MDIcon:
                        icon: "check-decagram"
                        font_size: "64sp"
                        theme_text_color: "Custom"
                        text_color: 0.12, 0.53, 0.90, 1
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "DoIt!"
                        font_style: "H3"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.12, 0.53, 0.90, 1
                        pos_hint: {"center_y": 0.5}

                MDLabel:
                    text: "Masuk ke Akun Anda"
                    font_style: "Body2"
                    halign: "center"
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: "20dp"

                MDTextField:
                    id: email_input
                    hint_text: "Email / Username"
                    icon_left: "account"
                    mode: "rectangle"

                MDRelativeLayout:
                    size_hint_y: None
                    height: "60dp"

                    MDTextField:
                        id: password_input
                        hint_text: "Kata Sandi"
                        icon_left: "lock"
                        password: True
                        mode: "rectangle"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    MDIconButton:
                        icon: "eye-off"
                        pos_hint: {"right": 0.98, "center_y": 0.4}
                        on_release: root.toggle_password_visibility(self)

                MDRaisedButton:
                    text: "MASUK"
                    size_hint_x: 1
                    height: "48dp"
                    md_bg_color: 0.12, 0.53, 0.90, 1
                    on_release: root.do_login()

                MDFlatButton:
                    text: "Belum punya akun? Daftar sekarang"
                    pos_hint: {"center_x": 0.5}
                    theme_text_color: "Custom"
                    text_color: 0.12, 0.53, 0.90, 1
                    on_release: root.manager.current = "register"


<RegisterScreen>:
    MDFloatLayout:
        md_bg_color: 0.94, 0.96, 0.98, 1

        MDCard:
            size_hint: 0.88, None
            height: "510dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [20]
            padding: ["20dp", "20dp", "20dp", "20dp"]

            MDBoxLayout:
                orientation: "vertical"
                spacing: "14dp"

                # Logo diperbesar secara signifikan
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "70dp"
                    pos_hint: {"center_x": 0.5}
                    spacing: "10dp"

                    MDIcon:
                        icon: "check-decagram"
                        font_size: "56sp"
                        theme_text_color: "Custom"
                        text_color: 0.12, 0.53, 0.90, 1
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "DoIt!"
                        font_style: "H3"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.12, 0.53, 0.90, 1
                        pos_hint: {"center_y": 0.5}

                MDLabel:
                    text: "Buat Akun Baru"
                    font_style: "Body2"
                    halign: "center"
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: "18dp"

                MDTextField:
                    id: reg_nama_input
                    hint_text: "Nama Lengkap"
                    icon_left: "account"
                    mode: "rectangle"

                MDTextField:
                    id: reg_email_input
                    hint_text: "Email"
                    icon_left: "email"
                    mode: "rectangle"

                MDTextField:
                    id: reg_password_input
                    hint_text: "Kata Sandi"
                    icon_left: "lock"
                    password: True
                    mode: "rectangle"

                MDRaisedButton:
                    text: "DAFTAR"
                    size_hint_x: 1
                    height: "48dp"
                    md_bg_color: 0.12, 0.53, 0.90, 1
                    on_release: root.do_register()

                MDFlatButton:
                    text: "Sudah punya akun? Login"
                    pos_hint: {"center_x": 0.5}
                    theme_text_color: "Custom"
                    text_color: 0.12, 0.53, 0.90, 1
                    on_release: root.manager.current = "login"


<MainScreen>:
    MDFloatLayout:
        md_bg_color: 0.96, 0.97, 0.99, 1

        # Header Atas
        MDBoxLayout:
            orientation: "vertical"
            size_hint: (1, None)
            height: "120dp"
            pos_hint: {"top": 1}
            md_bg_color: 0.12, 0.53, 0.90, 1
            padding: ["16dp", "16dp", "16dp", "10dp"]

            MDBoxLayout:
                orientation: "horizontal"

                MDBoxLayout:
                    orientation: "vertical"
                    MDLabel:
                        id: greeting_label
                        text: "Selamat Pagi!"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                    MDLabel:
                        text: "Selesaikan tugas & raih targetmu"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 0.9, 0.95, 1, 1

                MDCard:
                    size_hint: (None, None)
                    size: ("70dp", "36dp")
                    radius: [10]
                    md_bg_color: 1, 1, 1, 0.2
                    elevation: 0
                    pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "DoIt!"
                        bold: True
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

            MDCard:
                size_hint: (None, None)
                size: ("140dp", "28dp")
                radius: [12]
                md_bg_color: 1, 1, 1, 0.2
                elevation: 0

                MDBoxLayout:
                    orientation: "horizontal"
                    padding: ["8dp", "0dp", "8dp", "0dp"]
                    spacing: "4dp"
                    MDIcon:
                        icon: "calendar-month"
                        font_size: "16sp"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        pos_hint: {"center_y": 0.5}
                    MDLabel:
                        id: date_label
                        text: "17 Sep 2026"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        pos_hint: {"center_y": 0.5}

        # Content Screen Manager
        ScreenManager:
            id: main_sm
            size_hint: (1, None)
            height: "460dp"
            pos_hint: {"top": 0.81}

            # Tab Beranda
            Screen:
                name: "tab_beranda"
                MDBoxLayout:
                    orientation: "vertical"
                    padding: ["16dp", "10dp", "16dp", "10dp"]
                    spacing: "10dp"

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: "40dp"
                        spacing: "10dp"

                        MDRaisedButton:
                            id: btn_tugas
                            text: "Tugas"
                            size_hint_x: 0.5
                            md_bg_color: 0.12, 0.53, 0.90, 1
                            text_color: 1, 1, 1, 1
                            on_release: root.switch_filter("Tugas")

                        MDRaisedButton:
                            id: btn_kebiasaan
                            text: "Kebiasaan"
                            size_hint_x: 0.5
                            md_bg_color: 0.85, 0.88, 0.92, 1
                            text_color: 0.3, 0.3, 0.3, 1
                            on_release: root.switch_filter("Kebiasaan")

                    ScrollView:
                        MDList:
                            id: task_list
                            spacing: "8dp"

            # Tab Statistik
            Screen:
                name: "tab_statistik"
                MDBoxLayout:
                    orientation: "vertical"
                    padding: ["16dp", "10dp", "16dp", "10dp"]
                    spacing: "12dp"

                    MDCard:
                        size_hint: (1, None)
                        height: "70dp"
                        radius: [14]
                        padding: ["16dp", "10dp", "16dp", "10dp"]
                        md_bg_color: 1, 0.95, 0.9, 1
                        elevation: 1

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: "12dp"

                            MDIcon:
                                icon: "fire"
                                font_size: "32sp"
                                theme_text_color: "Custom"
                                text_color: 0.95, 0.4, 0.1, 1
                                pos_hint: {"center_y": 0.5}

                            MDBoxLayout:
                                orientation: "vertical"
                                pos_hint: {"center_y": 0.5}
                                MDLabel:
                                    text: "Streak Saat Ini"
                                    font_style: "Caption"
                                    theme_text_color: "Secondary"
                                MDLabel:
                                    id: streak_label
                                    text: "0 Hari Beruntun"
                                    font_style: "Subtitle1"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: 0.95, 0.4, 0.1, 1

                    MDCard:
                        size_hint: (1, None)
                        height: "170dp"
                        radius: [14]
                        padding: ["12dp", "10dp", "12dp", "10dp"]
                        elevation: 1

                        MDBoxLayout:
                            orientation: "vertical"

                            MDLabel:
                                text: "Tugas Selesai (7 Hari Terakhir)"
                                font_style: "Caption"
                                bold: True
                                theme_text_color: "Secondary"
                                size_hint_y: None
                                height: "20dp"

                            MDBoxLayout:
                                id: chart_container
                                orientation: "horizontal"
                                spacing: "6dp"

                    MDLabel:
                        text: "Riwayat Selesai"
                        font_style: "Subtitle2"
                        bold: True
                        size_hint_y: None
                        height: "24dp"

                    ScrollView:
                        MDList:
                            id: history_list
                            spacing: "8dp"

            # Tab Profil
            Screen:
                name: "tab_profil"
                ScrollView:
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: ["16dp", "10dp", "16dp", "20dp"]
                        spacing: "14dp"
                        size_hint_y: None
                        height: self.minimum_height

                        # Card Avatar
                        MDCard:
                            size_hint: (1, None)
                            height: "140dp"
                            radius: [14]
                            padding: "12dp"
                            elevation: 1

                            MDBoxLayout:
                                orientation: "vertical"
                                alignment_vertical: "center"
                                pos_hint: {"center_x": 0.5}
                                spacing: "4dp"

                                MDIcon:
                                    id: profile_avatar_icon
                                    icon: "account"
                                    font_size: "48sp"
                                    theme_text_color: "Custom"
                                    text_color: 0.12, 0.53, 0.90, 1
                                    pos_hint: {"center_x": 0.5}

                                MDLabel:
                                    id: profile_nama
                                    text: "Pengguna"
                                    font_style: "Subtitle1"
                                    bold: True
                                    halign: "center"

                                MDLabel:
                                    id: profile_email
                                    text: "email@domain.com"
                                    font_style: "Caption"
                                    theme_text_color: "Secondary"
                                    halign: "center"

                                MDFlatButton:
                                    text: "Edit Profil"
                                    theme_text_color: "Custom"
                                    text_color: 0.12, 0.53, 0.90, 1
                                    pos_hint: {"center_x": 0.5}
                                    on_release: root.open_edit_profile()

                        # Informasi Akun
                        MDCard:
                            size_hint: (1, None)
                            height: "130dp"
                            radius: [14]
                            padding: "14dp"
                            elevation: 1

                            MDBoxLayout:
                                orientation: "vertical"
                                spacing: "8dp"

                                MDLabel:
                                    text: "Informasi Akun"
                                    font_style: "Subtitle2"
                                    bold: True

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    spacing: "10dp"
                                    MDIcon:
                                        icon: "email-outline"
                                        theme_text_color: "Secondary"
                                    MDLabel:
                                        id: profile_info_email
                                        text: "email@domain.com"
                                        font_style: "Body2"

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    spacing: "10dp"
                                    MDIcon:
                                        icon: "account-outline"
                                        theme_text_color: "Secondary"
                                    MDLabel:
                                        id: profile_info_nama
                                        text: "Nama Pengguna"
                                        font_style: "Body2"

                        # Logout
                        MDRaisedButton:
                            text: "KELUAR (LOGOUT)"
                            size_hint_x: 1
                            height: "44dp"
                            md_bg_color: 0.88, 0.2, 0.2, 1
                            on_release: root.do_logout()

        # Tombol Tambah FAB
        MDFloatingActionButton:
            icon: "plus"
            md_bg_color: 0.12, 0.53, 0.90, 1
            pos_hint: {"right": 0.9, "y": 0.11}
            on_release: root.show_add_task_dialog()

        # Bottom Navigation Bar
        MDCard:
            size_hint: (1, None)
            height: "56dp"
            pos_hint: {"bottom": 1}
            elevation: 8
            radius: [0, 0, 0, 0]
            md_bg_color: 1, 1, 1, 1

            MDBoxLayout:
                orientation: "horizontal"

                MDIconButton:
                    icon: "home"
                    size_hint_x: 0.33
                    theme_icon_color: "Custom"
                    icon_color: 0.12, 0.53, 0.90, 1
                    on_release:
                        main_sm.current = "tab_beranda"

                MDIconButton:
                    icon: "chart-bar"
                    size_hint_x: 0.33
                    theme_icon_color: "Custom"
                    icon_color: 0.5, 0.5, 0.5, 1
                    on_release:
                        main_sm.current = "tab_statistik"

                MDIconButton:
                    icon: "account"
                    size_hint_x: 0.33
                    theme_icon_color: "Custom"
                    icon_color: 0.5, 0.5, 0.5, 1
                    on_release:
                        main_sm.current = "tab_profil"


<EditProfileScreen>:
    MDFloatLayout:
        md_bg_color: 0.94, 0.96, 0.98, 1

        MDBoxLayout:
            orientation: "vertical"
            size_hint: (1, None)
            height: "56dp"
            pos_hint: {"top": 1}
            md_bg_color: 0.12, 0.53, 0.90, 1
            padding: ["8dp", "0dp", "8dp", "0dp"]

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "8dp"

                MDIconButton:
                    icon: "arrow-left"
                    theme_icon_color: "Custom"
                    icon_color: 1, 1, 1, 1
                    pos_hint: {"center_y": 0.5}
                    on_release: root.manager.current = "main"

                MDLabel:
                    text: "Edit Profil"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    pos_hint: {"center_y": 0.5}

        ScrollView:
            size_hint: (1, None)
            height: "570dp"
            pos_hint: {"top": 0.9}

            MDBoxLayout:
                orientation: "vertical"
                padding: ["16dp", "16dp", "16dp", "20dp"]
                spacing: "14dp"
                size_hint_y: None
                height: self.minimum_height

                # Pilihan Avatar MDIcon
                MDCard:
                    size_hint: (1, None)
                    height: "130dp"
                    radius: [14]
                    padding: "12dp"
                    elevation: 1

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "8dp"

                        MDLabel:
                            text: "Pilih Avatar"
                            font_style: "Subtitle2"
                            bold: True
                            halign: "center"

                        MDIcon:
                            id: avatar_preview_icon
                            icon: "account"
                            font_size: "36sp"
                            theme_text_color: "Custom"
                            text_color: 0.12, 0.53, 0.90, 1
                            pos_hint: {"center_x": 0.5}

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: "8dp"
                            pos_hint: {"center_x": 0.5}

                            MDIconButton:
                                icon: "account"
                                on_release: root.select_avatar("account")
                            MDIconButton:
                                icon: "robot"
                                on_release: root.select_avatar("robot")
                            MDIconButton:
                                icon: "cat"
                                on_release: root.select_avatar("cat")
                            MDIconButton:
                                icon: "dog"
                                on_release: root.select_avatar("dog")
                            MDIconButton:
                                icon: "emoticon-happy"
                                on_release: root.select_avatar("emoticon-happy")

                # Form Informasi
                MDCard:
                    size_hint: (1, None)
                    height: "160dp"
                    radius: [14]
                    padding: "14dp"
                    elevation: 1

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "10dp"

                        MDLabel:
                            text: "Informasi Akun"
                            font_style: "Subtitle2"
                            bold: True

                        MDTextField:
                            id: edit_nama_input
                            hint_text: "Nama Lengkap"
                            icon_left: "account"

                        MDTextField:
                            id: edit_email_input
                            hint_text: "Email"
                            icon_left: "email"

                # Form Password
                MDCard:
                    size_hint: (1, None)
                    height: "210dp"
                    radius: [14]
                    padding: "14dp"
                    elevation: 1

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "10dp"

                        MDLabel:
                            text: "Ubah Kata Sandi (Opsional)"
                            font_style: "Subtitle2"
                            bold: True

                        MDTextField:
                            id: pass_old
                            hint_text: "Kata Sandi Lama"
                            icon_left: "lock"
                            password: True

                        MDTextField:
                            id: pass_new
                            hint_text: "Kata Sandi Baru"
                            icon_left: "lock-reset"
                            password: True

                        MDTextField:
                            id: pass_confirm
                            hint_text: "Konfirmasi Kata Sandi Baru"
                            icon_left: "lock-check"
                            password: True

                MDRaisedButton:
                    text: "SIMPAN PERUBAHAN"
                    size_hint_x: 1
                    height: "48dp"
                    md_bg_color: 0.12, 0.53, 0.90, 1
                    on_release: root.save_changes()